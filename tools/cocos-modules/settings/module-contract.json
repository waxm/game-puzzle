      "reference": "npm run verify:puzzle-systems"
    },
    {
      "gate": "lifecycle",
      "type": "automation",
      "result": "面板关闭使异步动作失效并注销全部按钮事件。",
      "reference": "UISettingsPanel.onClose + npm run verify"
    },
    {
      "gate": "regression",
      "type": "command",
      "result": "完整项目回归通过。",
      "reference": "npm run verify"
    }
  ],
  "deliverables": [
    {
      "kind": "source",
      "path": "assets/app/game/settings/PuzzleSettingsManager.ts",
      "requiredFor": ["runnable", "test"]
    },
    {
      "kind": "source",
      "path": "assets/app/ui/popup/UISettingsPanel.ts",
      "requiredFor": ["runnable", "test"]
    },
    {
      "kind": "prefab",
      "path": "assets/resources/prefabs/popup/UISettingsPanel.prefab",
      "requiredFor": ["runnable", "test"]
    },
    {
      "kind": "test",
      "path": "tools/verify-puzzle-systems.mjs",
      "requiredFor": ["test"]
    },
    {
      "kind": "document",
      "path": "docs/PUZZLE_SYSTEM_MODULES.md",
      "requiredFor": ["test"]
    }
  ]
}
