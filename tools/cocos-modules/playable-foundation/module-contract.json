  "project": {
    "creatorVersion": "3.8.4",
    "designResolution": {
      "width": 640,
      "height": 1136
    },
    "orientation": "portrait"
  },
  "scope": {
    "included": [
      "宽屏 iframe、短屏和长屏下完整显示竖屏游戏",
      "场景、UI、Prefab 路径和业务存档键集中注册",
      "旧进度键迁移、损坏进度修复和运行时边界校验",
      "未使用 Cocos 引擎模块裁剪",
      "项目就绪自动化、性能预算和系统扩展记录"
    ],
    "excluded": [
      "实现设置、音频界面、选关、教程或商业化系统",
      "修改拼图棋盘、移动、组合、胜负和计时规则",
      "重新设计现有 Scene、Prefab 或 Texture",
      "改变现有关卡资源、编号或解锁顺序"
    ]
  },
  "decisions": [
    {
      "id": "show-all-resolution",
      "confidence": "confirmed",
      "impact": "behavior",
      "statement": "Web 发布统一使用 SHOW_ALL，任何 iframe 比例都优先完整显示设计画面。",
      "sources": [
        "user-readiness-request",
        "project-rules"
      ]
    },
    {
      "id": "central-runtime-registry",
      "confidence": "confirmed",
      "impact": "structure",
      "statement": "正式场景、UI、Prefab 路径、对象池和存档键由 PuzzleGameKey 统一登记。",
      "sources": [
        "project-rules",
        "existing-project"
      ]
    },
    {
      "id": "migrate-progress-key",
      "confidence": "confirmed",
      "impact": "data",
      "statement": "旧 puzzleProgress 自动迁移到 puzzle.progress，迁移完成后移除旧键。",
      "sources": [
        "project-rules",
        "existing-project"
      ]
    },
    {
      "id": "defer-system-features",
      "confidence": "confirmed",
      "impact": "scope",
      "statement": "本模块只提供可扩展基础，设置、音频、选关和暂停帮助必须分别交付。",
      "sources": [
        "user-readiness-request"
      ]
    }
  ],
  "openQuestions": [],
  "states": [
    "booting",
    "lobby-ready",
    "game-ready",
    "transitioning",
    "recoverable-error",
    "disposed"
  ],
  "transitions": [
    {
      "event": "boot-complete",
      "from": "booting",
      "to": "lobby-ready",
      "authority": "BootScene"
    },
    {
      "event": "start-game",
      "from": "lobby-ready",
      "to": "transitioning",
      "authority": "LobbyScene"
    },
    {
      "event": "game-loaded",
      "from": "transitioning",
      "to": "game-ready",
      "authority": "SceneManager"
    },
    {
      "event": "load-failed",
      "from": "transitioning",
      "to": "recoverable-error",
      "authority": "Scene entry"
    },
    {
      "event": "retry",
      "from": "recoverable-error",
      "to": "transitioning",
      "authority": "UILoadErrorPanel"
    },
    {
      "event": "exit",
      "from": "game-ready",
      "to": "disposed",
      "authority": "GameScene"
    }
  ],
  "architecture": {
    "artifacts": [
      {
        "id": "runtime-key-registry",
        "role": "config",
        "responsibility": "集中维护场景、UI、Prefab、对象池和存档键。"
      },
      {
        "id": "progress-migration",
        "role": "persistence",
        "responsibility": "迁移旧进度、修复损坏数据并输出规范化副本。"
      },
      {
        "id": "resolution-policy",
        "role": "platform",
        "responsibility": "保证竖屏设计画面在任意 Web 容器中完整可见。"
      },
      {
        "id": "engine-feature-profile",
        "role": "build",
        "responsibility": "只编译当前拼图依赖的 2D 模块和 Creator 3.8.4 SpriteFrame 所需的 3D 基础兼容层。"
      },
      {
        "id": "readiness-verifier",
        "role": "test",
        "responsibility": "自动检查注册表、资源路径、适配策略和引擎模块边界。"
      }
    ]
  },
