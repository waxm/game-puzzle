        "verify": "npm run typecheck && npm run verify:cocos-web && npm run verify:readiness && npm run verify:core && npm run verify:game && npm run validate:cocos",
        "verify:game": "npm run verify:puzzle-progress && npm run verify:puzzle-systems && npm run validate:levels && npm run verify:level-editor && npm run verify:puzzle-groups && npm run verify:puzzle-drag && npm run verify:puzzle-rules && npm run verify:puzzle-controller && npm run verify:puzzle-lifecycle"
